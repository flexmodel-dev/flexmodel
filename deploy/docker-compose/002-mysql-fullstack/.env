CONTAINER_NAME_PREFIX=prod2

# 杩愯妯″紡: native (GraalVM 鍘熺敓闀滃儚) 鎴?jvm (JVM 妯″紡)
# 鍒囨崲鏂瑰紡锛氫慨鏀?FLEXMODEL_RUN_MODE 鍜?FLEXMODEL_SERVER_IMAGE 涓よ
#   native 鈫?FLEXMODEL_SERVER_IMAGE=cjbi/flexmodel-server-native:latest
#   jvm    鈫?FLEXMODEL_SERVER_IMAGE=cjbi/flexmodel-server:latest
FLEXMODEL_SERVER_IMAGE=cjbi/flexmodel-server-native:latest

# mysql
MYSQL_DATABASE=flexmodel
MYSQL_ROOT_PASSWORD=123456

# nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# rabbitmq
RABBITMQ_DEFAULT_USER=flexmodel
RABBITMQ_DEFAULT_PASS=flexmodel
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VIRTUAL_HOST=/

# rustfs (S3-compatible object storage)
RUSTFS_ACCESS_KEY=flexmodel
RUSTFS_SECRET_KEY=flexmodel123456
RUSTFS_BUCKET=flexmodel
# S3 API port (host) - used by external tools; server reaches rustfs internally
RUSTFS_S3_API_PORT=9000
# Web console port (host)
RUSTFS_CONSOLE_PORT=9001

# Project base domain (used for subdomain routing)
# e.g. preview.flexmodel.dev 鈫?{projectId}.preview.flexmodel.dev
FLEXMODEL_PROJECT_BASE_DOMAIN=flexmodel.wetech.tech