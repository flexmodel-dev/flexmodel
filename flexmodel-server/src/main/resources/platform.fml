model f_app_data_authorization {
  id : String @id @default(uuid()) @length("64"),
  app_id : String @length("64"),
  form_name : String @length("64"),
  name : String @length("255"),
  enabled : Boolean @default("true"),
  subjects : JSON,
  data_scope : JSON,
  @index(name: "IDX_DATA_AUTH_FORM", fields: [app_id, form_name]),
  @system,
  @comment("数据授权")
}

model f_app_data_permission_control {
  id : String @id @default(uuid()) @length("64"),
  authorization_id : String @length("64"),
  form_name : String @length("64"),
  read_all : Boolean @default("false"),
  write_all : Boolean @default("false"),
  allow_delete : Boolean @default("false"),
  field_controls? : JSON,
  condition? : JSON,
  @index(name: "UQ_DATA_PERMISSION_FORM", unique: true, fields: [authorization_id, form_name]),
  @system,
  @comment("表单数据权限控制")
}

model f_app_record_discussion {
  id : String @id @length("64"),
  app_id : String @length("64"),
  form_name : String @length("64"),
  record_id : String @length("64"),
  parent_id : String @length("64") @comment("顶层讨论为空串，回复存顶层讨论ID"),
  reply_to_name? : String @length("128") @comment("回复目标作者姓名快照"),
  content : String @length("2000"),
  author_id : String @length("64"),
  author_name : String @length("128"),
  mentioned_user_ids? : JSON,
  created_at : DateTime,
  @index(name: "IDX_APP_DISCUSSION_RECORD", fields: [app_id, form_name, record_id, created_at]),
  @index(name: "IDX_APP_DISCUSSION_PARENT", fields: [app_id, parent_id]),
  @system,
  @comment("记录讨论")
}

model f_app_record_history {
  id : String @id @length("64"),
  app_id : String @length("64"),
  event_key : String @length("180") @comment("服务端生成的事件去重键"),
  operation_id? : String @length("128") @comment("同一次导入、节点执行等关联标识"),
  form_name : String @length("64") @comment("实际被操作的业务表单"),
  form_label? : String @length("128"),
  record_id : String @length("64"),
  record_label? : String @length("255") @comment("主显字段摘要快照"),
  event_type : String @length("40"),
  source : String @length("20") @comment("APPS、IMPORT、APPROVAL"),
  actor_type : String @length("10") @comment("USER 或 SYSTEM"),
  actor_id? : String @length("64"),
  actor_name : String @length("128"),
  occurred_at : DateTime,
  recorded_at : DateTime,
  changes? : JSON @comment("字段变化及展示快照"),
  context? : JSON @comment("主子表、导入、审批等扩展信息"),
  trace_id? : String @length("64"),
  @index(name: "UQ_APP_HISTORY_EVENT", unique: true, fields: [app_id, event_key]),
  @index(name: "IDX_APP_HISTORY_RECORD", fields: [app_id, form_name, record_id, occurred_at]),
  @system,
  @comment("应用记录操作历史")
}

model f_app_record_history_target {
  id : String @id @length("64"),
  app_id : String @length("64"),
  event_id : String @length("64"),
  form_name : String @length("64") @comment("时间线所属表单"),
  record_id : String @length("64") @comment("时间线所属记录"),
  target_type : String @length("10") @comment("SELF 或 PARENT"),
  occurred_at : DateTime,
  @index(name: "UQ_APP_HISTORY_TARGET", unique: true, fields: [app_id, event_id, form_name, record_id]),
  @index(name: "IDX_APP_HISTORY_TARGET_RECORD", fields: [app_id, form_name, record_id, occurred_at, event_id]),
  @system,
  @comment("应用记录历史展示目标")
}

model f_notification {
  id: String @id,
  project_id: String,
  event_key: String @length("180"),
  recipient_id: String,
  category: String,
  title: String @length("200"),
  content: String @length("5000"),
  app_name: String,
  instance_id?: String,
  task_id?: String,
  discussion_id?: String @length("64"),
  occurred_at: DateTime,
  received_at: DateTime,
  read_at?: DateTime,
  is_read: Boolean,
  @index(name: "UQ_NOTIFICATION_EVENT_USER", unique: true, fields: [project_id, event_key, recipient_id]),
  @index(name: "IDX_NOTIFICATION_INBOX", fields: [recipient_id, received_at]),
  @index(name: "IDX_NOTIFICATION_UNREAD", fields: [recipient_id, is_read, received_at]),
  @system
}
model f_notification_stream {
  id: String @id,
  version: Long,
  unread: Long,
  @system
}
model f_notification_event {
  id: String @id,
  recipient_id: String,
  version: Long,
  type: String,
  payload: JSON,
  published: Boolean,
  created_at: DateTime,
  @index(name: "UQ_NOTIFICATION_CURSOR", unique: true, fields: [recipient_id, version]),
  @index(name: "IDX_NOTIFICATION_DISPATCH", fields: [published]),
  @system
}

model f_project {
  id : String @id @default(uuid()),
  name: String,
  description?: String,
  enabled : Boolean @comment("是否启用") @default("true"),
  parent_project_id?: String @comment("父项目ID, 分支项目指向其父项目"),
  database_name?: String @comment("项目数据库名称"),
  owner_id?: String @comment("所有者 ID"),
  metadata?: JSON @comment("元数据"),
  created_by?: String @comment("创建人"),
  updated_by?: String @comment("更新人"),
  created_at?: DateTime @default(now()) @comment("创建时间"),
  updated_at?: DateTime @default(now()) @comment("更新时间"),
  @index(name: "IDX_PROJECT_PARENT", fields: [parent_project_id]),
  @system,
  @comment("项目")
}
model f_app {
  id : String @id @length("64") @comment("应用ID，与 f_project.id 一对一共享"),
  icon_name : String @length("64") @comment("图标名"),
  primary_color : String @length("32") @comment("主色"),
  provisioning? : String @length("32") @comment("导入重建状态，空表示正常"),
  navigation? : JSON @comment("导航配置"),
  forms? : JSON @comment("表单配置"),
  created_by? : String @comment("创建人"),
  updated_by? : String @comment("更新人"),
  created_at? : DateTime @default(now()) @comment("创建时间"),
  updated_at? : DateTime @default(now()) @comment("更新时间"),
  @system,
  @comment("应用")
}
model f_branch {
  id : String @id @default(uuid()),
  project_id : String @comment("所属项目ID"),
  name : String @comment("分支名称"),
  database_name : String @comment("分支数据库名称"),
  source_branch?: String @default("main") @comment("来源分支"),
  description? : String @comment("分支描述"),
  created_by? : String @comment("创建人"),
  created_at? : DateTime @default(now()) @comment("创建时间"),
  @index(name: "IDX_BRANCH_PROJECT_NAME", unique: true, fields: [project_id, name]),
  @system,
  @comment("项目分支")
}

model f_app_workbench {
  id : String @id @default(uuid()),
  app_id : String @comment("所属应用ID"),
  name : String @comment("工作台名称"),
  description? : String @comment("工作台描述"),
  layout : JSON @comment("工作台布局"),
  created_by? : String @comment("创建人"),
  updated_by? : String @comment("更新人"),
  created_at? : DateTime @default(now()) @comment("创建时间"),
  updated_at? : DateTime @default(now()) @comment("更新时间"),
  @index(name: "IDX_WORKBENCH_APP", fields: [app_id]),
  @index(name: "UQ_WORKBENCH_APP_NAME", unique: true, fields: [app_id, name]),
  @system,
  @comment("应用工作台")
}

model f_auth_api_key {
  id : String @id @default(uuid()),
  name : String @length("255") @comment("Key 名称"),
  key_hash : String @length("64") @comment("SHA-256 哈希"),
  key_prefix : String @length("16") @comment("前缀(fm_ak_xxx)"),
  project_ids? : String @length("1000") @comment("可访问的项目ID列表,逗号分隔,空表示全部"),
  read_only : Boolean @default("false") @comment("是否只读"),
  expires_at? : DateTime @comment("过期时间"),
  last_used_at? : DateTime @comment("最后使用时间"),
  created_at? : DateTime @default(now()) @comment("创建时间"),
  updated_at? : DateTime @default(now()) @comment("更新时间"),
  @index(name: "IDX_AUTH_AK_HASH", unique: true, fields: [key_hash]),
  @system,
  @comment("API Key")
}

enum UserStatus {
  ACTIVE,
  DISABLED,
  INVITED,
  @system
}

model f_user {
  id : String @id @default(uuid()),
  name? : String @length("255") @comment("名称"),
  email? : String @length("255") @comment("邮箱"),
  phone? : String @length("50") @comment("工作电话"),
  avatar? : String @length("2048") @comment("头像"),
  password_hash : String @length("255") @comment("密码HASH"),
  manager_user_id? : String @length("64") @comment("直属主管用户ID"),
  status : UserStatus @default("ACTIVE") @comment("状态"),
  created_by?: String @comment("创建人"),
  updated_by?: String @comment("更新人"),
  created_at?: DateTime @default(now()) @comment("创建时间"),
  updated_at?: DateTime @default(now()) @comment("更新时间"),
  @index(name : "IDX_USERNAME", unique: "true", fields: [name]),
  @index(name : "IDX_EMAIL", unique: "true", fields: [email]),
  @index(name : "IDX_USER_MANAGER", fields : [manager_user_id]),
  @metadata({
    label: "用户",
    description: "系统用户表单",
    displayField: "name",
    searchField: "name",
    fields: [
      {name: "name", label: "姓名", type: "TEXT", required: true},
      {name: "email", label: "邮箱", type: "EMAIL"},
      {name: "phone", label: "工作电话", type: "PHONE"},
      {name: "password", label: "密码", type: "TEXT"},
      {name: "status", label: "状态", type: "SELECT", required: true, options: [
        {id: "ACTIVE", text: "启用"},
        {id: "DISABLED", text: "停用"},
        {id: "INVITED", text: "待激活"}
      ]},
      {name: "manager_user_id", label: "直属主管", type: "REFERENCE", referenceForm: "f_user"},
      {name: "roleIds", label: "角色", type: "MULTIREFERENCE", referenceForm: "f_role"}
    ],
    layout: {items: [
      {type: "SECTION", label: "基础信息", width: "FULL"},
      {type: "FIELD", name: "name", width: "HALF"},
      {type: "FIELD", name: "email", width: "HALF"},
      {type: "FIELD", name: "password", width: "HALF"},
      {type: "FIELD", name: "status", width: "QUARTER"},
      {type: "FIELD", name: "manager_user_id", width: "QUARTER"},
      {type: "SECTION", label: "组织关系", width: "FULL"},
      {type: "SUBFORM", name: "departments", label: "任职", width: "FULL", formName: "f_user_department", referenceField: "user_id"},
      {type: "FIELD", name: "roleIds", label: "角色", width: "FULL"}
    ]},
    listColumns: [
      {name: "name", label: "姓名"},
      {name: "email", label: "邮箱"},
      {name: "status", label: "状态"},
      {name: "departments", label: "任职"},
      {name: "roles", label: "角色"}
    ],
    page: {title: "组织用户", description: "维护用户基础信息、任职与角色", pageSize: 30, leftComponent: "DEPARTMENT_TREE"},
    components: {
      departments: {type: "USER_DEPARTMENTS", label: "任职"},
      roles: {type: "USER_ROLES", label: "角色"}
    },
    designable: true
  }),
  @system,
  @comment("用户")
}

model f_department {
  id : String @id @default(uuid()),
  name : String @length("255") @comment("部门名称"),
  parent_id? : String @length("64") @comment("父级部门ID"),
  created_by? : String @comment("创建人"),
  updated_by? : String @comment("更新人"),
  created_at? : DateTime @default(now()) @comment("创建时间"),
  updated_at? : DateTime @default(now()) @comment("更新时间"),
  @index(name : "IDX_DEPARTMENT_PARENT", fields : [parent_id]),
  @metadata({
    label: "部门",
    description: "系统部门表单",
    displayField: "name",
    searchField: "name",
    fields: [
      {name: "name", label: "部门名称", type: "TEXT", required: true},
      {name: "parent_id", label: "上级部门", type: "TEXT"}
    ],
    layout: {items: [
      {type: "SECTION", label: "基础信息", width: "FULL"},
      {type: "FIELD", name: "name", width: "HALF"},
      {type: "FIELD", name: "parent_id", width: "HALF"}
    ]},
    listColumns: [
      {name: "name", label: "部门名称"},
      {name: "parent_id", label: "上级部门"},
      {name: "direct_user_count", label: "成员数"}
    ],
    page: {title: "部门", description: "维护组织架构", pageSize: 30},
    components: {},
    designable: true
  }),
  @system,
  @comment("部门架构")
}

model f_user_department {
  id : String @id @default(uuid()),
  user_id : String @length("64") @comment("用户ID"),
  department_id : String @length("64") @comment("部门ID"),
  is_main : Boolean @default("false") @comment("是否主部门"),
  job_title? : String @length("64") @comment("职位"),
  created_by? : String @comment("创建人"),
  updated_by? : String @comment("更新人"),
  created_at? : DateTime @default(now()) @comment("创建时间"),
  updated_at? : DateTime @default(now()) @comment("更新时间"),
  @index(name : "UQ_USER_DEPARTMENT", unique : "true", fields : [user_id, department_id]),
  @index(name : "IDX_USER_DEPARTMENT_USER", fields : [user_id]),
  @index(name : "IDX_USER_DEPARTMENT_DEPARTMENT", fields : [department_id]),
  @index(name : "IDX_USER_DEPARTMENT_MAIN", fields : [is_main]),
  @system,
  @comment("用户部门关系")
}

model f_user_role {
  id : String @id @default(uuid()),
  user_id : String @length("64") @comment("用户ID"),
  role_id : String @length("64") @comment("角色ID"),
  created_by? : String @comment("创建人"),
  updated_by? : String @comment("更新人"),
  created_at? : DateTime @default(now()) @comment("创建时间"),
  updated_at? : DateTime @default(now()) @comment("更新时间"),
  @index(name : "UQ_USER_ROLE", unique : "true", fields : [user_id, role_id]),
  @index(name : "IDX_USER_ROLE_USER", fields : [user_id]),
  @index(name : "IDX_USER_ROLE_ROLE", fields : [role_id]),
  @system,
  @comment("用户角色关系")
}
model f_role {
  id : String @id @unique @default(uuid()),
  name : String @length("255"),
  description? : String @length("255"),
  created_by?: String @comment("创建人"),
  updated_by?: String @comment("更新人"),
  created_at?: DateTime @default(now()) @comment("创建时间"),
  updated_at?: DateTime @default(now()) @comment("更新时间"),
  @index(name:"IDX_ROLE_NAME", unique: "true", fields: [name]),
  @metadata({
    label: "角色",
    description: "系统角色表单",
    displayField: "name",
    searchField: "name",
    fields: [
      {name: "name", label: "角色名称", type: "TEXT", required: true},
      {name: "description", label: "角色说明", type: "TEXT"},
      {name: "resourceIds", label: "可访问权限", type: "MULTIREFERENCE"}
    ],
    layout: {items: [
      {type: "SECTION", label: "基础信息", width: "FULL"},
      {type: "FIELD", name: "name", width: "HALF"},
      {type: "FIELD", name: "description", width: "HALF"},
      {type: "SECTION", label: "权限", width: "FULL"},
      {type: "FIELD", name: "resourceIds", label: "可访问权限", width: "FULL"}
    ]},
    listColumns: [
      {name: "name", label: "角色名称"},
      {name: "description", label: "说明"},
      {name: "resources", label: "权限资源"}
    ],
    page: {title: "角色权限", description: "维护角色及其权限", pageSize: 30},
    components: {
      resources: {type: "ROLE_PERMISSIONS", label: "可访问权限"}
    },
    designable: true
  }),
  @system,
  @comment("角色")
}

model f_role_resource {
  id : String @id @default(uuid()),
  role_id : String @length("64") @comment("角色ID"),
  resource_id : Long @comment("资源ID"),
  created_by? : String @comment("创建人"),
  updated_by? : String @comment("更新人"),
  created_at? : DateTime @default(now()) @comment("创建时间"),
  updated_at? : DateTime @default(now()) @comment("更新时间"),
  @index(name : "UQ_ROLE_RESOURCE", unique : "true", fields : [role_id, resource_id]),
  @index(name : "IDX_ROLE_RESOURCE_ROLE", fields : [role_id]),
  @index(name : "IDX_ROLE_RESOURCE_RESOURCE", fields : [resource_id]),
  @system,
  @comment("角色资源关系")
}
model f_resource {
  id: Long @id @default(autoIncrement()),
  name : String @length("255"),
  permission: String @length("255") @comment("权限标识"),
  type: String @length("100") @comment("类型, platform: 平台级, project: 项目级"),
  parent_id?: Long,
  @system,
  @comment("资源")
}
model f_resource_template {
  id: Long @id @default(autoIncrement()),
  name: String @length("255"),
  permission: String @length("255") @comment("权限标识"),
  parent_id?: Long,
  @system,
  @comment("资源模版")
}
model f_config {
  id : String @id @unique @default(uuid()),
  key : String @comment("名称") @length("255"),
  value? : String @length("255"),
  created_at : DateTime @default(now()),
  updated_at : DateTime @default(now()),
  @comment("配置"),
  @index(name:"IDX_CONFIG_KEY", unique: "true", fields: [key]),
  @system,
  @comment("系统配置")
}

// Quartz 持久化表模型（根据提供的表结构生成）
// 约定：
// 1) 每个模型均包含默认主键字段 id。
// 2) 原表的 PRIMARY KEY（通常为复合键）用唯一索引实现，命名保持接近官方索引名。
// 3) BLOB 字段以 JSON 存储；布尔型标志位(VARCHAR(1))以 Boolean 表示。

model f_qrtz_job_detail {
  id : String @id @default(uuid()),
  sched_name : String @length("120") @comment("调度器名称"),
  job_name : String @length("190") @comment("任务名称"),
  job_group : String @length("190") @comment("任务分组"),
  description? : String @length("250") @comment("任务描述"),
  job_class_name : String @length("250") @comment("任务实现类名"),
  is_durable : Boolean @comment("是否持久化(原 VARCHAR(1))"),
  is_nonconcurrent : Boolean @comment("是否不并发执行(原 VARCHAR(1))"),
  is_update_data : Boolean @comment("执行后是否更新数据(原 VARCHAR(1))"),
  requests_recovery : Boolean @comment("是否请求恢复(原 VARCHAR(1))"),
  job_data? : JSON @comment("任务数据(原 BLOB)"),
  @index(name:"UQ_QRTZ_JOB_DETAILS_PK", unique: "true", fields: [sched_name, job_name, job_group]),
  @index(name:"IDX_QRTZ_J_REQ_RECOVERY", unique: "false", fields: [sched_name, requests_recovery]),
  @index(name:"IDX_QRTZ_J_GRP", unique: "false", fields: [sched_name, job_group]),
  @system,
  @comment("Quartz 任务明细")
}

model f_qrtz_trigger {
  id : String @id @default(uuid()),
  sched_name : String @length("120") @comment("调度器名称"),
  trigger_name : String @length("190") @comment("触发器名称"),
  trigger_group : String @length("190") @comment("触发器分组"),
  job_name : String @length("190") @comment("关联任务名称"),
  job_group : String @length("190") @comment("关联任务分组"),
  description? : String @length("250") @comment("触发器描述"),
  next_fire_time? : Long @comment("下次触发时间(毫秒)"),
  prev_fire_time? : Long @comment("上次触发时间(毫秒)"),
  priority? : Int @comment("优先级"),
  trigger_state : String @length("16") @comment("触发器状态"),
  trigger_type : String @length("8") @comment("触发器类型(如 CRON/SIMPLE)"),
  start_time : Long @comment("开始时间(毫秒)"),
  end_time? : Long @comment("结束时间(毫秒)"),
  calendar_name? : String @length("190") @comment("日历名称"),
  misfire_instr? : Int @comment("误触发指令(原 SMALLINT)"),
  job_data? : JSON @comment("触发器数据(原 BLOB)"),
  @index(name:"UQ_QRTZ_TRIGGERS_PK", unique: "true", fields: [sched_name, trigger_name, trigger_group]),
  @index(name:"IDX_QRTZ_T_J", unique: "false", fields: [sched_name, job_name, job_group]),
  @index(name:"IDX_QRTZ_T_JG", unique: "false", fields: [sched_name, job_group]),
  @index(name:"IDX_QRTZ_T_C", unique: "false", fields: [sched_name, calendar_name]),
  @index(name:"IDX_QRTZ_T_G", unique: "false", fields: [sched_name, trigger_group]),
  @index(name:"IDX_QRTZ_T_STATE", unique: "false", fields: [sched_name, trigger_state]),
  @index(name:"IDX_QRTZ_T_N_STATE", unique: "false", fields: [sched_name, trigger_name, trigger_group, trigger_state]),
  @index(name:"IDX_QRTZ_T_N_G_STATE", unique: "false", fields: [sched_name, trigger_group, trigger_state]),
  @index(name:"IDX_QRTZ_T_NEXT_FIRE_TIME", unique: "false", fields: [sched_name, next_fire_time]),
  @index(name:"IDX_QRTZ_T_NFT_ST", unique: "false", fields: [sched_name, trigger_state, next_fire_time]),
  @index(name:"IDX_QRTZ_T_NFT_MISFIRE", unique: "false", fields: [sched_name, misfire_instr, next_fire_time]),
  @index(name:"IDX_QRTZ_T_NFT_ST_MISFIRE", unique: "false", fields: [sched_name, misfire_instr, next_fire_time, trigger_state]),
  @index(name:"IDX_QRTZ_T_NFT_ST_MISFIRE_GRP", unique: "false", fields: [sched_name, misfire_instr, next_fire_time, trigger_group, trigger_state]),
  @system,
  @comment("Quartz 触发器")
}

model f_qrtz_simple_trigger {
  id : String @id @default(uuid()),
  sched_name : String @length("120") @comment("调度器名称"),
  trigger_name : String @length("190") @comment("触发器名称"),
  trigger_group : String @length("190") @comment("触发器分组"),
  repeat_count : Long @comment("重复次数"),
  repeat_interval : Long @comment("重复间隔(毫秒)"),
  times_triggered : Long @comment("已触发次数"),
