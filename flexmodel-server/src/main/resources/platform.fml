  @index(name:"IDX_JOB_EXEC_TRIGGER_ID", unique: false, fields: [project_id, trigger_id]),
  @index(name:"IDX_JOB_EXEC_JOB_ID", unique: false, fields: [project_id, job_id]),
  @index(name:"IDX_JOB_EXEC_SCHEDULER", unique: false, fields: [project_id, scheduler_name]),
  @index(name:"IDX_JOB_EXEC_STATUS", unique: false, fields: [project_id, execution_status]),
  @index(name:"IDX_JOB_EXEC_START_TIME", unique: false, fields: [project_id, start_time]),
  @index(name:"IDX_JOB_EXEC_SUCCESS", unique: false, fields: [project_id, is_success]),
  @index(name:"IDX_JOB_EXEC_COMPOSITE", unique: false, fields: [project_id, trigger_id, start_time]),
  @index(name:"IDX_JOB_EXEC_TRACE_ID", unique: false, fields: [project_id, trace_id]),
  @system,
  @comment("作业执行日志")
}

model f_function {
