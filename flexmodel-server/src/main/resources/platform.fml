  event_key?: String @comment("外部处理器的幂等消费标识"),
  attributes?: JSON @comment("外部处理器的业务执行结果"),
  created_by?: String @comment("创建人"),
  updated_by?: String @comment("更新人"),
  created_at?: DateTime @default(now()) @comment("创建时间"),
  updated_at?: DateTime @default(now()) @comment("更新时间"),
  @index(name: "UQ_NODE_INSTANCE_EVENT", unique: true, fields: [project_id, event_key]),
  @index(name: "IDX_NODE_INSTANCE_LOG_FLOW", fields: [project_id, flow_instance_id]),
  @index(name: "IDX_NODE_INSTANCE_LOG_TRACE", fields: [project_id, trace_id]),
  @system,
  @comment("节点执行记录")
}

model f_ei_instance_data {
  id: Long @id @default(autoIncrement()),
  project_id: String @comment("所属项目ID"),
  node_instance_id: String @comment("节点执行实例id"),
  flow_instance_id: String @comment("流程执行实例id"),
  instance_data_id: String @comment("实例数据id"),
  flow_deploy_id: String @comment("流程模型部署id"),
  flow_module_id: String @comment("流程模型id"),
  node_key: String @comment("节点唯一标识"),
  instance_data: String @length(1000000) @comment("数据列表json"),
  type: Int @default(0) @comment("操作类型(1.实例初始化 2.系统执行 3.系统主动获取 4.上游更新 5.任务提交 6.任务撤回)"),
  archive: Int @default(0) @comment("归档状态(0未删除，1删除)"),
  created_by?: String @comment("创建人"),
  updated_by?: String @comment("更新人"),
  created_at?: DateTime @default(now()) @comment("创建时间"),
  updated_at?: DateTime @default(now()) @comment("更新时间"),
  @index(name: "UQ_INSTANCE_DATA", unique: true, fields: [project_id, instance_data_id]),
  @index(name: "IDX_INSTANCE_DATA_FLOW", fields: [project_id, flow_instance_id]),
  @system,
  @comment("实例数据")
}

model f_trigger {
  id : String @id @default(uuid()),
