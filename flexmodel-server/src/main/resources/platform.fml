  {project_id: "dev_test",  "id": "hello", "name": "hello", "source_files": { "index.ts": "export default async function(req: Request, ctx: Context) {\n  return new Response(JSON.stringify({ message: \"Hello, World!\" }), {\n    headers: { \"content-type\": \"application/json\" }\n  });\n}" }},
  {project_id: "dev_test",  "id": "student_query", "name": "student_query", "source_files": { "index.ts": "import { flexmodelClient } from '@flexmodel/sdk';\nimport { Student } from './type.ts';\n\nexport default async (input) => {\n  // runtime 已在调用前 setAuthToken + setProjectId\n  console.log(\"请求参数: \"+JSON.stringify(input));\n  console.warn(\"这是一个警告信息\"); // 黄色惊叹号图标\n  console.error(\"这是一个错误信息\"); // 红色错误图标，并自带错误堆栈\n  const { list } = await flexmodelClient.data.Student.findMany({ where: { age: { _eq: 10 } } });\n  return { list };\n}", "type.ts": "// Add your code here\nexport interface Student {\n    studentName: string;\n}" } },
  {project_id: "dev_test",  "id": "health-check", "name": "health-check", "source_files": { "index.ts": "export default async function(req: Request) {\n  const url = \"http://localhost:9999/health\";\n\n  try {\n    const response = await fetch(url);\n\n    if (!response.ok) {\n      return new Response(JSON.stringify({ error: \"Health check failed\", status: response.status }), {\n        status: 401,\n        headers: { \"content-type\": \"application/json\" }\n      });\n    }\n    console.log(\"Health check succeeded\");\n\n    return new Response(JSON.stringify({\n       success: true\n    }), {\n      headers: { \"content-type\": \"application/json\" }\n    });\n  } catch (err) {\n    console.error(\"Health check failed\", err);\n    return new Response(JSON.stringify({ error: \"Health check failed\" }), {\n      status: 401,\n      headers: { \"content-type\": \"application/json\" }\n    });\n  }\n}" }, "timeout": 30, "created_at": "2026-07-15T10:49:31.493042100", "updated_at": "2026-07-15T10:49:31.493042100" }
}
