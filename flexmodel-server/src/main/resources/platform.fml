  created_at: DateTime,
  error?: String @length(10000),
  @index(name: "UQ_RUNTIME_MESSAGE", unique: true, fields: [project_id, message_id]),
  @index(name: "IDX_RUNTIME_DELIVERY", fields: [project_id, state, available_at]),
  @index(name: "IDX_RUNTIME_ORDER", fields: [project_id, ordering_key, id]),
