}

seed f_function_template {
  {id: "tpl-001", name: "Hello World", slug: "hello-world", description: "最简单的函数，返回问候语", source_files: {"index.ts": "export default async function(req: Request) {\n  return new Response(JSON.stringify({ message: \"Hello, World!\" }), {\n    headers: { \"content-type\": \"application/json\" }\n  });\n}"}, tags: "[\"beginner\"]", icon: "code", sort_order: 1},
  {id: "tpl-002", name: "Database Query", slug: "database-query", description: "查询 Flexmodel 数据表并返回结果", source_files: {"index.ts": "import { flexmodelClient } from \"@flexmodel/sdk\";\n\nexport default async function(req: Request) {\n  const url = new URL(req.url);\n  const model = url.searchParams.get(\"model\") || \"Student\";\n  const page = Number(url.searchParams.get(\"page\") || \"1\");\n  const size = Number(url.searchParams.get(\"size\") || \"10\");\n  const result = await flexmodelClient.data.from(model).findMany({ page, size });\n  console.log(\"Query completed\", { model, total: result.total });\n  return new Response(JSON.stringify(result), {\n    headers: { \"content-type\": \"application/json\" }\n  });\n}"}, tags: "[\"database\"]", icon: "database", sort_order: 2},
  {id: "tpl-003", name: "Database CRUD", slug: "database-crud", description: "根据请求方法执行增删改查操作", source_files: {"index.ts": "import { flexmodelClient } from \"@flexmodel/sdk\";\n\nexport default async function(req: Request) {\n  const url = new URL(req.url);\n  const model = url.searchParams.get(\"model\") || \"Student\";\n  const id = url.searchParams.get(\"id\");\n  if (req.method === \"GET\" && id) {\n    const record = await flexmodelClient.data.from(model).findOne(id);\n    return new Response(JSON.stringify(record), { headers: { \"content-type\": \"application/json\" } });\n  }\n  if (req.method === \"GET\") {\n    const result = await flexmodelClient.data.from(model).findMany({ page: 1, size: 10 });\n    return new Response(JSON.stringify(result), { headers: { \"content-type\": \"application/json\" } });\n  }\n  if (req.method === \"POST\") {\n    const body = await req.json();\n    const record = await flexmodelClient.data.from(model).create(body);\n    return new Response(JSON.stringify(record), { status: 201, headers: { \"content-type\": \"application/json\" } });\n  }\n  return new Response(JSON.stringify({ error: \"Method not supported\" }), { status: 405 });\n}"}, tags: "[\"database\"]", icon: "database", sort_order: 3},
  {id: "tpl-004", name: "IdP Authentication", slug: "idp-authentication", description: "对接第三方 IdP（如 OIDC/OAuth2）进行认证，验证 token 并返回 userId", source_files: {"index.ts": "export default async function(req: Request) {\n  // AuthContext 作为 Request body 传入，包含 bearerToken、headers 等信息\n  // 同时原始客户端 headers 也通过 Request headers 传递\n  const ctx = await req.json();\n  const bearerToken = ctx.bearerToken || req.headers.get(\"Authorization\")?.replace(\"Bearer \", \"\");\n\n  if (!bearerToken) {\n    return new Response(JSON.stringify({ error: \"Missing bearer token\" }), {\n      status: 401,\n      headers: { \"content-type\": \"application/json\" }\n    });\n  }\n\n  // 调用 IdP 的 userinfo 端点验证 token\n  // 请根据你的 IdP 替换 userinfo URL\n  const userinfoUrl = \"https://your-idp-domain.com/oauth2/userinfo\";\n\n  try {\n    const response = await fetch(userinfoUrl, {\n      headers: { Authorization: \"Bearer \" + bearerToken }\n    });\n\n    if (!response.ok) {\n      return new Response(JSON.stringify({ error: \"Token validation failed\", status: response.status }), {\n        status: 401,\n        headers: { \"content-type\": \"application/json\" }\n      });\n    }\n\n    const userInfo = await response.json();\n\n    // 认证成功 — 返回 userId 供 Flexmodel 识别用户身份\n    // userId 通常取 IdP 返回的 sub 字段\n    console.log(\"IdP auth succeeded\", { sub: userInfo.sub, email: userInfo.email });\n\n    return new Response(JSON.stringify({\n      userId: userInfo.sub,\n      email: userInfo.email,\n      name: userInfo.name\n    }), {\n      headers: { \"content-type\": \"application/json\" }\n    });\n  } catch (err) {\n    console.error(\"IdP auth error\", err);\n    return new Response(JSON.stringify({ error: \"IdP connection failed\" }), {\n      status: 401,\n      headers: { \"content-type\": \"application/json\" }\n    });\n  }\n}"}, tags: "[\"auth\", \"integration\"]", icon: "safety", sort_order: 6},
  {id: "tpl-005", name: "IdP Authentication with JWT", slug: "auth-jwt", description: "JWT Token 认证函数，验证 Bearer Token 中的 upn claim 并返回用户信息", source_files: {"index.ts": "import jwt from \"npm:jsonwebtoken\";\n\nconst ACCOUNT = \"upn\"; \n\nexport default async function (req: Request) {\n  // 1. 提取 Bearer Token\n  let token: string | null = null;\n  try {\n    token = req.headers.get(\"Authorization\")?.replace(\"Bearer \", \"\") ?? null;\n    if (!token && req.body) {\n      const ct = req.headers.get(\"content-type\") ?? \"\";\n      if (ct.includes(\"application/json\")) {\n        token = (await req.json().catch(() => ({}))).bearerToken ?? null;\n      }\n    }\n  } catch {\n    // ignore parse errors\n  }\n\n  if (!token) {\n    return new Response(JSON.stringify({ error: \"Missing bearer token\" }), {\n      status: 401,\n      headers: { \"content-type\": \"application/json\" },\n    });\n  }\n\n  // 2. 对应 JwtService.verify(): 先解码取 upn → 拼接密钥 → 验证签名\n  const BASE = Deno.env.get(\"JWT_SECRET\") || \"your-secret\";\n\n  try {\n    // 对应 getClaim(token, ACCOUNT)\n    const upn = (jwt.decode(token) as Record<string, unknown> | null)?.[ACCOUNT];\n    if (!upn || typeof upn !== \"string\") {\n      throw new Error(\"missing upn claim\");\n    }\n\n    // 对应 String secret = getClaim(token, ACCOUNT) + config.jwt().secret()\n    //       Algorithm.HMAC256(secret) + verifier.verify(token)\n    const verified = jwt.verify(token, upn + BASE, { algorithms: [\"HS256\"] }) as Record<string, unknown>;\n\n    console.log(\"JWT 认证成功\", { upn: verified[ACCOUNT] });\n\n    return new Response(\n      JSON.stringify({\n        userId: verified[ACCOUNT],\n        email: verified.email || \"\",\n        name: verified.name || \"\",\n      }),\n      { headers: { \"content-type\": \"application/json\" } },\n    );\n  } catch (err) {\n    console.error(\"JWT 验证失败:\", err instanceof Error ? err.message : err);\n    return new Response(JSON.stringify({ error: \"Invalid or expired token\" }), {\n      status: 401,\n      headers: { \"content-type\": \"application/json\" },\n    });\n  }\n}"}, tags: "[\"auth\"]", icon: "safety", sort_order: 5},
  {id: "tpl-006", name: "AI Example", slug: "ai-example", description: "调用 DeepSeek API 的 AI 边缘函数示例", source_files: {"index.ts": "import OpenAI from \"npm:openai\"; // Deno 会自动下载并缓存该 npm 包\n\nconst openai = new OpenAI({\n  apiKey: Deno.env.get(\"DEEPSEEK_API_KEY\"), // 从环境变量读取 API Key\n  baseURL: \"https://api.deepseek.com/v1\",   // 配置 DeepSeek 的官方接口地址\n});\n\n\nexport default async function(req: Request) {\n\n  const completion = await openai.chat.completions.create({\n    messages: [{ role: \"user\", content: \"你好，请自我介绍一下。\" }],\n    model: \"deepseek-v4-flash\",\n  });\n  console.log(completion.choices[0].message.content);\n  return new Response(JSON.stringify({ message: completion }), {\n    headers: { \"content-type\": \"application/json\" }\n  });\n}"}, tags: "[\"ai\", \"beginner\"]", icon: "robot", sort_order: 7},
}

